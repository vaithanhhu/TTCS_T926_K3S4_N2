# Copy to .env.mac (ignored by Git). Do not copy a Windows .env or node_modules.
NODE_ENV=development
DB_PROVIDER=postgres
# Fill locally with an approved PostgreSQL endpoint and URI-encoded credentials.
DATABASE_URL=
PG_SSL_MODE=verify
PORT=5050
APP_URL=http://127.0.0.1:5050
# Explicit local development default; use approved SMTP configuration when needed.
EMAIL_MODE=simulated
# For a private CA, EXPORT NODE_EXTRA_CA_CERTS in Terminal BEFORE launching Node.
# No shell expansion or shell commands are evaluated inside this file.
