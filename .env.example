# ==============================================================================
# HỆ THỐNG TUYỂN DỤNG NỘI BỘ (ATS) — CẤU HÌNH MÔI TRƯỜNG DOANH NGHIỆP
# ==============================================================================

# Cổng máy chủ backend & frontend
PORT=5050

# Đường dẫn cơ sở dữ liệu SQLite
DB_PATH=backend/data/ats.db

# Đường dẫn URL ứng dụng (dùng cho link kích hoạt tài khoản & đặt lại mật khẩu)
APP_URL=http://localhost:5050

# Thời hạn phiên làm việc (phút) & khóa tài khoản do brute-force
SESSION_TTL_MINUTES=30
LOCK_TIME_MINUTES=15
MAX_FAILED_ATTEMPTS=5
PASSWORD_RESET_TTL_MINUTES=30
# OTP quên mật khẩu cố định 5 phút, độc lập với reset token 30 phút.

# ==============================================================================
# CẤU HÌNH DỊCH VỤ EMAIL THẬT (SMTP)
# Hỗ trợ cấu hình theo cả chuẩn MAIL_* lẫn SMTP_*
# Gmail SMTP dùng OAuth2/XOAUTH2, không yêu cầu App Password:
# ==============================================================================
NODE_ENV=production
EMAIL_MODE=smtp
# Test tự dùng simulated, không kết nối SMTP.
# Chỉ development mới cho phép NODE_ENV=development + EMAIL_MODE=simulated.
# Thiếu SMTP trong chế độ smtp là lỗi nội bộ, không giả lập thành công.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_FROM="Hệ thống Tuyển dụng ATS <your-email@gmail.com>"
EMAIL_AUTH_MODE=oauth2
GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_client_id
GOOGLE_OAUTH_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_OAUTH_REFRESH_TOKEN=your_google_oauth_refresh_token
# Refresh token phải được cấp cho MAIL_USERNAME với scope https://mail.google.com/
# Nodemailer tự lấy/refresh access token. Không ghi token vào log hoặc source.
# Bất kỳ biến OAuth nào được cấu hình đều ưu tiên OAuth2, kể cả khi còn password.
# OAuth thiếu cấu hình hoặc thất bại không fallback sang password/simulated.

# Hoặc dùng định dạng SMTP_*:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_FROM=your_sender@example.com
# SMTP_SECURE=false
# SMTP provider khác vẫn hỗ trợ password khi không có các biến OAuth:
# EMAIL_AUTH_MODE=password
# MAIL_PASSWORD=your_smtp_password
# Hoặc SMTP_PASSWORD=your_smtp_password
# Database: leave DATABASE_URL empty for SQLite compatibility.
# Set DB_PROVIDER=postgres and DATABASE_URL yourself for PostgreSQL/Neon.
# PG_SSL_MODE=url uses URI SSL options; verify enables certificate validation; disable is for local test servers only.
DB_PROVIDER=
DATABASE_URL=
PG_SSL_MODE=url
