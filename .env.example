# ==============================================================================
# HỆ THỐNG TUYỂN DỤNG NỘI BỘ (ATS) — CẤU HÌNH MÔI TRƯỜNG DOANH NGHIỆP
# ==============================================================================

# Cổng máy chủ backend & frontend
PORT=5050

# Đường dẫn cơ sở dữ liệu SQLite
DB_PATH=backend/data/ats.db

# Đường dẫn URL ứng dụng (dùng cho link kích hoạt tài khoản & đặt lại mật khẩu)
APP_URL=http://localhost:5050

# Thời hạn phiên làm việc (phút) & khóa tài khoản do brute-force
SESSION_TTL_MINUTES=30
LOCK_TIME_MINUTES=15
MAX_FAILED_ATTEMPTS=5
PASSWORD_RESET_TTL_MINUTES=30

# ==============================================================================
# CẤU HÌNH DỊCH VỤ EMAIL THẬT (SMTP)
# Hỗ trợ cấu hình theo cả chuẩn MAIL_* lẫn SMTP_*
# Ví dụ cấu hình với Gmail SMTP (Sử dụng App Password 16 chữ số):
# ==============================================================================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your_16_char_gmail_app_password
MAIL_FROM="Hệ thống Tuyển dụng ATS <your-email@gmail.com>"

# Hoặc dùng định dạng SMTP_*:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your_16_char_gmail_app_password
# SMTP_SECURE=false
