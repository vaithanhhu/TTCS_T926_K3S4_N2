# Cấu hình môi trường Hệ thống Tuyển dụng Nội bộ (ATS)
# Sao chép file này thành .env để tùy chỉnh môi trường: cp .env.example .env

# PostgreSQL Configuration
POSTGRES_DB=ats_recruitment
POSTGRES_USER=ats_user
POSTGRES_PASSWORD=ats_secret123
POSTGRES_PORT=5432

# Mailpit (Local SMTP Server & Web Viewer)
SMTP_HOST=mailpit
SMTP_PORT=1025
MAILPIT_WEB_PORT=8025

# Adminer (Database Web Interface)
ADMINER_PORT=8080

# Frontend Configuration
FRONTEND_PORT=3000
VITE_API_URL=http://localhost:8080/api

# Security & Tokens
JWT_SECRET=super_secret_jwt_key_for_recruitment_system_sprint_1_development_token_2026
JWT_EXPIRATION_MINUTES=60
REFRESH_TOKEN_EXPIRATION_DAYS=7
